.container.py-5
  .row
    .col-12.text-center.mb-5
      h1.display-3.fw-bold = I18n.t('home.title')
      p.lead = I18n.t('home.subtitle')
  
  .row.mt-5.mb-5
    .col-12
      h2.text-center.mb-4 = I18n.t('home.button_showcase')
      
      .mb-4
        h4.mb-3 = I18n.t('home.solid_buttons')
        .d-flex.flex-wrap.justify-content-center
          a.btn.btn-primary.me-3.mb-3 href="#" = I18n.t('home.button_primary')
          a.btn.btn-secondary.me-3.mb-3 href="#" = I18n.t('home.button_secondary')
          a.btn.btn-success.me-3.mb-3 href="#" = I18n.t('home.button_success')
          a.btn.btn-danger.me-3.mb-3 href="#" = I18n.t('home.button_danger')
          a.btn.btn-warning.me-3.mb-3 href="#" = I18n.t('home.button_warning')
          a.btn.btn-info.me-3.mb-3 href="#" = I18n.t('home.button_info')
          a.btn.btn-light.me-3.mb-3 href="#" = I18n.t('home.button_light')
          a.btn.btn-dark.me-3.mb-3 href="#" = I18n.t('home.button_dark')
      
      .mb-4
        h4.mb-3 = I18n.t('home.outline_buttons')
        .d-flex.flex-wrap.justify-content-center
          a.btn.btn-outline-primary.me-3.mb-3 href="#" = I18n.t('home.button_outline_primary')
          a.btn.btn-outline-secondary.me-3.mb-3 href="#" = I18n.t('home.button_outline_secondary')
          a.btn.btn-outline-success.me-3.mb-3 href="#" = I18n.t('home.button_outline_success')
          a.btn.btn-outline-danger.me-3.mb-3 href="#" = I18n.t('home.button_outline_danger')
          a.btn.btn-outline-warning.me-3.mb-3 href="#" = I18n.t('home.button_outline_warning')
          a.btn.btn-outline-info.me-3.mb-3 href="#" = I18n.t('home.button_outline_info')
          a.btn.btn-outline-light.me-3.mb-3 href="#" = I18n.t('home.button_outline_light')
          a.btn.btn-outline-dark.me-3.mb-3 href="#" = I18n.t('home.button_outline_dark')
  
  .row.mt-5.mb-5
    .col-12
      h2.text-center.mb-4 = I18n.t('home.alert_showcase')
      .row.justify-content-center
        .col-md-8
          .alert.alert-success.mb-3 role="alert"
            span.alert-icon
            .alert-content
              strong = I18n.t('home.alert_success_title')
              = " #{I18n.t('home.alert_success_message')}"
          .alert.alert-info.mb-3 role="alert"
            span.alert-icon
            .alert-content
              strong = I18n.t('home.alert_info_title')
              = " #{I18n.t('home.alert_info_message')}"
          .alert.alert-warning.mb-3 role="alert"
            span.alert-icon
            .alert-content
              strong = I18n.t('home.alert_warning_title')
              = " #{I18n.t('home.alert_warning_message')}"
          .alert.alert-danger.mb-3 role="alert"
            span.alert-icon
            .alert-content
              strong = I18n.t('home.alert_danger_title')
              = " #{I18n.t('home.alert_danger_message')}"
  
  .row.mt-5.g-4
    .col-md-4
      .card.border-3.border-dark style="box-shadow: 4px 4px 0 #000;"
        .card-body.p-4
          h3.fw-bold = I18n.t('home.feature_shopping_lists_title')
          p.mt-3 = I18n.t('home.feature_shopping_lists_description')
    
    .col-md-4
      .card.border-3.border-dark style="box-shadow: 4px 4px 0 #000;"
        .card-body.p-4
          h3.fw-bold = I18n.t('home.feature_recipe_ideas_title')
          p.mt-3 = I18n.t('home.feature_recipe_ideas_description')
    
    .col-md-4
      .card.border-3.border-dark style="box-shadow: 4px 4px 0 #000;"
        .card-body.p-4
          h3.fw-bold = I18n.t('home.feature_family_sharing_title')
          p.mt-3 = I18n.t('home.feature_family_sharing_description')
