.container-fluid.p-0.overflow-hidden
  section.hero-section.py-5.border-bottom.border-3.border-dark.bg-light
    .container
      .row.align_items-center.min-vh-75
        .col-lg-6.py-5
          h1.display-1.fw-black.mb-4 style="font-weight: 900; letter-spacing: -2px;" = I18n.t('home.hero.headline')
          p.lead.fs-3.mb-5.fw-bold = I18n.t('home.hero.subtitle')
          - if helpers.current_user
            a.btn.btn-lg.btn-primary.border-3.border-dark.fs-4.px-5.py-3.shadow-lg href=helpers.shopping_lists_path style="box-shadow: 6px 6px 0 #000 !important;"
              = I18n.t('navbar.shopping_lists')
          - else
            .d-flex.gap-3
              a.btn.btn-lg.btn-primary.border-3.border-dark.fs-4.px-5.py-3.shadow-lg href=helpers.new_user_session_path style="box-shadow: 6px 6px 0 #000 !important;"
                = I18n.t('sessions.form.title')
              a.btn.btn-lg.btn-outline-dark.border-3.fs-4.px-5.py-3.shadow-lg href=helpers.new_user_registration_path style="box-shadow: 6px 6px 0 #000 !important;"
                = I18n.t('registrations.form.title')
        .col-lg-6.text-center
          = image_tag "home/hero_shopping.png", class: "img-fluid border-3 border-dark", style: "border: 3px solid #000; box-shadow: 8px 8px 0 #000; max-height: 500px;"

  section.problem-section.py-5.bg-warning.border-bottom.border-3.border-dark
    .container
      .row.align-items-center
        .col-lg-5
          = image_tag "home/problem_chaos.png", class: "img-fluid border-3 border-dark mb-4 mb-lg-0", style: "border: 3px solid #000; box-shadow: -8px 8px 0 #000;"
        .col-lg-7
          h2.display-4.fw-bold.mb-5.text-uppercase style="background: #fff; display: inline-block; padding: 10px; border: 3px solid #000; box-shadow: 4px 4px 0 #000;" THE CHAOS
          
          .card.mb-4.border-3.border-dark.bg-white style="box-shadow: 4px 4px 0 #000;"
            .card-body
              h3.h4.fw-bold = I18n.t('home.problem.forgotten_item.title')
              p.mb-0 = I18n.t('home.problem.forgotten_item.description')

          .card.mb-4.border-3.border-dark.bg-white style="box-shadow: 4px 4px 0 #000;"
            .card-body
              h3.h4.fw-bold = I18n.t('home.problem.double_buy.title')
              p.mb-0 = I18n.t('home.problem.double_buy.description')

          .card.border-3.border-dark.bg-white style="box-shadow: 4px 4px 0 #000;"
            .card-body
              h3.h4.fw-bold = I18n.t('home.problem.messy_chat.title')
              p.mb-0 = I18n.t('home.problem.messy_chat.description')

  section.solution-section.py-5.bg-white.border-bottom.border-3.border-dark
    .container
      .row.align-items-center.flex-lg-row-reverse
        .col-lg-6.text-center
           = image_tag "home/solution_sync.png", class: "img-fluid border-3 border-dark mb-4 mb-lg-0", style: "border: 3px solid #000; box-shadow: 8px 8px 0 #000;"
        .col-lg-6
          h2.display-4.fw-bold.mb-5.text-uppercase style="background: #0dcaf0; display: inline-block; padding: 10px; border: 3px solid #000; box-shadow: 4px 4px 0 #000;" THE SOLUTION
          
          .d-flex.align-items-start.mb-4
            .display-4.fw-bold.me-4 1.
            div
              h3.fw-bold = I18n.t('home.solution.create.title')
              p.lead = I18n.t('home.solution.create.description')
          
          .d-flex.align-items-start.mb-4
            .display-4.fw-bold.me-4 2.
            div
              h3.fw-bold = I18n.t('home.solution.invite.title')
              p.lead = I18n.t('home.solution.invite.description')

          .d-flex.align-items-start.mb-4
            .display-4.fw-bold.me-4 3.
            div
              h3.fw-bold = I18n.t('home.solution.sync.title')
              p.lead = I18n.t('home.solution.sync.description')

  section.features-section.py-5.bg-light
    .container
      .row.g-4
        .col-md-4
          .card.h-100.border-3.border-dark.bg-warning style="box-shadow: 6px 6px 0 #000;"
            .card-body.p-4.text-center
              .mb-3
                i.bi.bi-clock-history.display-1
              h3.fw-bold = I18n.t('home.features.real_time')
        
        .col-md-4
          .card.h-100.border-3.border-dark.bg-success.text-white style="box-shadow: 6px 6px 0 #000;"
            .card-body.p-4.text-center
              .mb-3
                i.bi.bi-lightbulb.display-1
              h3.fw-bold = I18n.t('home.features.smart_suggestions')

        .col-md-4
          .card.h-100.border-3.border-dark.bg-primary.text-white style="box-shadow: 6px 6px 0 #000;"
            .card-body.p-4.text-center
              .mb-3
                i.bi.bi-palette.display-1
              h3.fw-bold = I18n.t('home.features.beautiful_interface')

  section.cta-section.py-5.text-center.bg-dark.text-white
    .container.py-5
       h2.display-3.fw-bold.mb-4 = I18n.t('home.hero.cta')
       - if helpers.current_user
         a.btn.btn-lg.btn-warning.border-3.border-white.fs-3.px-5.py-3.fw-bold href=helpers.shopping_lists_path style="box-shadow: 6px 6px 0 #fff; color: #000;"
           = I18n.t('navbar.shopping_lists')
       - else
         a.btn.btn-lg.btn-warning.border-3.border-white.fs-3.px-5.py-3.fw-bold href=helpers.new_user_session_path style="box-shadow: 6px 6px 0 #fff; color: #000;"
           = I18n.t('sessions.form.title')
