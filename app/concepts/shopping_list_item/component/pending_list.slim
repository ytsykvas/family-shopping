- if @pending_items.any?
  .shopping-items-list
    - @pending_items.each do |item|
      .shopping-item.d-flex.align-items-center.justify-content-between.mb-2 data-controller="inline-edit"
        = form_with url: helpers.shopping_list_shopping_list_item_path(@shopping_list, item), method: :patch, local: true, class: "d-flex align-items-center me-2" do |f|
          = f.hidden_field :shopping_list_item, name: "shopping_list_item[status]", value: "done"
          label.shopping-item-checkbox.d-flex.align-items-center
            = f.check_box :status, { class: "form-check-input-custom shopping-checkbox", onchange: "this.form.submit()" }, "done", "pending"

        .flex-grow-1.me-2
          .d-flex.align-items-center.justify-content-between data-inline-edit-target="view"
            .d-flex.flex-column
              span.shopping-item-name = item.name
              span.text-muted.small = I18n.t('shopping_lists.show.added_by', name: item.added_by.nickname)
            
            - if @can_manage
              i.bi.bi-pencil-square.text-muted.cursor-pointer.ms-2 data-action="click->inline-edit#toggle" style="cursor: pointer; font-size: 1.1rem;"
          - if @can_manage
            .d-none.w-100 data-inline-edit-target="form"
              = form_with model: item, url: helpers.shopping_list_shopping_list_item_path(@shopping_list, item), method: :patch, local: true, class: "d-flex flex-column flex-sm-row gap-2 align-items-stretch align-items-sm-center w-100" do |f|
                = f.text_field :name, class: "form-control form-control-sm border-2 border-dark w-100", data: { inline_edit_target: "input" }
                .d-flex.gap-2.justify-content-end
                  button.btn.btn-sm.btn-success.border-2.border-dark type="submit" style="box-shadow: 2px 2px 0 #000;"
                    i.bi.bi-check-lg
                  button.btn.btn-sm.btn-outline-danger.border-2.border-dark type="button" data-action="click->inline-edit#toggle" style="box-shadow: 2px 2px 0 #000;"
                    i.bi.bi-x-lg
        - if @can_manage
          = button_to helpers.shopping_list_shopping_list_item_path(@shopping_list, item), method: :delete, class: "btn-icon-delete", data: { turbo_confirm: I18n.t('shopping_list_items.destroy.confirm') } do
            i.bi.bi-trash
- else
  .text-center.text-muted.py-4
    i.bi.bi-basket.fs-1.mb-2.d-block
    = I18n.t('shopping_lists.show.no_items')
