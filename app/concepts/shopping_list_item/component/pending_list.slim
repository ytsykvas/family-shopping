- if @pending_items.any?
  .shopping-items-list id="pending-items-list"
    - @pending_items.each do |item|
      = render ShoppingListItem::Component::Item.new(shopping_list: @shopping_list, item: item, can_manage: @can_manage)
- else
  .text-center.text-muted.py-4 id="pending-items-empty"
    i.bi.bi-basket.fs-1.mb-2.d-block
    = I18n.t('shopping_lists.show.no_items')
