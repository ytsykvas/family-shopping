.container.mt-4
  = render Shared::TitleRow::Component::Show.new(title: I18n.t("friendship_requests.index.title"))

  - if @friendship_requests.any?
    .row.g-4
      - @friendship_requests.each do |friendship_request|
        .col-md-6.col-lg-4
          .card
            .card-body
              - if is_incoming_request?(friendship_request)
                .badge.bg-primary.mb-2 = I18n.t('friendship_requests.index.incoming_request')
              - else
                .badge.bg-success.mb-2 = I18n.t('friendship_requests.index.outgoing_request')
              .user-info
                .user-name.mb-2 = request_user(friendship_request).name
                hr
                .user-details.mb-3
                  .user-nickname.text-muted.small.mb-1 = "#{I18n.t('user_searches.nickname_label')} #{request_user(friendship_request).nickname}"
                  .user-email.text-muted.small = request_user(friendship_request).email
              .user-actions.mt-3.text-center
                - if is_incoming_request?(friendship_request)
                  .d-grid.gap-2
                    = button_to I18n.t('friendship_requests.index.accept'), friendship_request_path(friendship_request), method: :patch, class: 'btn btn-success btn-sm', style: 'width: 100%;', data: { turbo: false }
                    = button_to I18n.t('friendship_requests.index.reject'), friendship_request_path(friendship_request), method: :delete, class: 'btn btn-danger btn-sm', style: 'width: 100%;', data: { turbo: false }
                - else
                  = button_to I18n.t('friendship_requests.index.cancel'), friendship_request_path(friendship_request), method: :delete, class: 'btn btn-danger btn-sm', style: 'width: 100%;', data: { turbo: false }
  - else
    .empty-content-container
      i.bi.bi-people.empty-icon
      .empty-title = I18n.t("friendship_requests.index.no_friendship_requests_title")
      .empty-message = I18n.t("friendship_requests.index.no_friendship_requests")
