header.navbar-shell
  nav.navbar.navbar-custom.navbar-expand-lg aria-label="Primary navigation"
    .container-fluid.navbar-frame
      a.navbar-brand href=root_path
        .brand-wrapper
          .logo-box aria-hidden="true"
            span.logo-icon ⬣
          span.brand-text = I18n.t('navbar.brand')

      ul.navbar-nav.d-none.d-lg-flex.flex-row.navbar-desktop-links
        li.nav-item
          a.nav-link href="#" = I18n.t('navbar.shopping_lists')
        li.nav-item
          a.nav-link href="#" = I18n.t('navbar.wishlists')
        li.nav-item
          a.nav-link href="#" = I18n.t('navbar.events')
        li.nav-item
          a.nav-link href="#" = I18n.t('navbar.teams')
        li.nav-item
          a.nav-link href="#" = I18n.t('navbar.friends')

      .navbar-actions.d-none.d-lg-flex
        = link_to I18n.t('navbar.sign_in'), '#', class: 'btn btn-success ms-auto'

      button.navbar-toggler-mobile.d-lg-none type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarOffcanvas" aria-controls="navbarOffcanvas" aria-expanded="false" aria-label="Toggle navigation"
        span.hamburger-icon
          span.hamburger-line
          span.hamburger-line
          span.hamburger-line

  .offcanvas.offcanvas-end.navbar-offcanvas tabindex="-1" id="navbarOffcanvas" aria-labelledby="navbarOffcanvasLabel"
    .offcanvas-header.navbar-offcanvas-header
      span.navbar-brand-mobile#navbarOffcanvasLabel
        .brand-wrapper
          .logo-box-mobile aria-hidden="true"
            span.logo-icon ⬣
          span.brand-text-mobile = I18n.t('navbar.brand')
      button.btn.btn-close-custom type="button" data-bs-dismiss="offcanvas" aria-label="Close"
        span.close-icon ✕

    .offcanvas-body.p-0
      nav.navbar-offcanvas-nav aria-label="Mobile navigation"
        a.navbar-offcanvas-link href=root_path
          span = I18n.t('navbar.home')
          span.link-arrow ↗
        a.navbar-offcanvas-link href="#"
          span = I18n.t('navbar.shopping_lists')
          span.link-arrow ↗
        a.navbar-offcanvas-link href="#"
          span = I18n.t('navbar.wishlists')
          span.link-arrow ↗
        a.navbar-offcanvas-link href="#"
          span = I18n.t('navbar.events')
          span.link-arrow ↗
        a.navbar-offcanvas-link href="#"
          span = I18n.t('navbar.teams')
          span.link-arrow ↗
        a.navbar-offcanvas-link href="#"
          span = I18n.t('navbar.friends')
          span.link-arrow ↗

      .navbar-offcanvas-cta
        = link_to '#', class: 'btn btn-cta-offcanvas' do
          span = I18n.t('navbar.sign_in')
          span.cta-arrow ↗
