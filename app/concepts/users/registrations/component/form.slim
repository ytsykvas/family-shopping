= helpers.simple_form_for(resource, as: resource_name, url: helpers.user_registration_path, html: { class: 'form-custom', data: { turbo: false } }) do |f|
  = f.error_notification

  .form-group
    = f.input :name, autofocus: true, input_html: { class: 'form-control-custom' }, label_html: { class: 'form-label-custom' }

  .form-group data-controller="user--nickname-validation" data-user--nickname-validation-url-value="/api/v1/users/check_nickname"
    = f.input :nickname, input_html: { class: 'form-control-custom', data: { user__nickname_validation_target: 'input', action: 'input->user--nickname-validation#validate' } }, label_html: { class: 'form-label-custom' }, wrapper_html: { class: 'w-100' }
    .validation-feedback data-user--nickname-validation-target="feedback"

  .form-group data-controller="user--email-validation" data-user--email-validation-url-value="/api/v1/users/check_email"
    = f.input :email, autocomplete: 'email', input_html: { class: 'form-control-custom', data: { user__email_validation_target: 'input', action: 'input->user--email-validation#validate' } }, label_html: { class: 'form-label-custom' }, wrapper_html: { class: 'w-100' }
    .validation-feedback data-user--email-validation-target="feedback"

  .form-group
    = f.input :password, autocomplete: 'new-password', input_html: { class: 'form-control-custom' }, label_html: { class: 'form-label-custom' }, hint: I18n.t('registrations.form.password_hint')

  .form-group
    = f.input :password_confirmation, autocomplete: 'new-password', input_html: { class: 'form-control-custom' }, label_html: { class: 'form-label-custom' }

  .form-actions
    = f.button :submit, I18n.t('registrations.form.submit'), class: 'btn btn-submit-custom'
