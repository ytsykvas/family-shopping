= helpers.simple_form_for(resource, as: resource_name, url: helpers.user_session_path, html: { class: 'form-custom', data: { turbo: false } }) do |f|
  = f.error_notification

  .form-group
    = f.input :email, autofocus: true, autocomplete: 'email', input_html: { class: 'form-control-custom' }, label_html: { class: 'form-label-custom' }, label: I18n.t('sessions.form.email_label')

  .form-group
    = f.input :password, autocomplete: 'current-password', input_html: { class: 'form-control-custom' }, label_html: { class: 'form-label-custom' }

  - if devise_mapping.rememberable?
    .form-group.form-check-custom
      = f.input :remember_me, as: :boolean, input_html: { class: 'form-check-input-custom' }, label_html: { class: 'form-check-label-custom' }

  .form-actions
    = f.button :submit, I18n.t('sessions.form.submit'), class: 'btn btn-submit-custom'
