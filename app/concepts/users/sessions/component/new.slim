.card.form-card
  = image_tag "banners/login.png", class: "card-img-top border-bottom border-3 border-dark", style: "border-bottom: 3px solid #000;"
  .card-body
    h2.form-title = I18n.t('sessions.form.title')
    p.form-subtitle = I18n.t('sessions.form.subtitle')

    - if helpers.flash.any?
      - helpers.flash.each do |type, message|
        .alert.alert-dismissible.fade.show class="alert-#{type == 'notice' ? 'info' : type == 'alert' ? 'danger' : type == 'warning' ? 'warning' : type}" role="alert"
          .alert-icon
          .alert-content= message
          button.btn-close type="button" data-bs-dismiss="alert" aria-label="Close"

    = render Users::Sessions::Component::Form.new(resource: resource, resource_name: resource_name, devise_mapping: devise_mapping)

    .text-center.my-3
      span.fw-bold = I18n.t('basic.or')

    .form-actions
      = render Shared::GoogleSignInButton::Component::Show.new(text_key: 'sessions.form.google_sign_in')

    .form-footer
      - if devise_mapping.recoverable?
        = link_to I18n.t('sessions.form.forgot_password'), helpers.new_user_password_path, class: 'form-link'
      - if devise_mapping.registerable?
        p.form-footer-text
          = I18n.t('sessions.form.no_account')
          = link_to I18n.t('sessions.form.sign_up'), helpers.new_user_registration_path, class: 'form-link'
