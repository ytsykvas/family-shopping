.card.form-card
  = image_tag "banners/login.png", class: "card-img-top border-bottom border-3 border-dark", style: "border-bottom: 3px solid #000;"
  .card-body
    h2.form-title = I18n.t('sessions.form.title')
    p.form-subtitle = I18n.t('sessions.form.subtitle')

    - if helpers.flash.any?
      - helpers.flash.each do |type, message|
        .alert.alert-dismissible.fade.show class="alert-#{type == 'notice' ? 'info' : type == 'alert' ? 'danger' : type == 'warning' ? 'warning' : type}" role="alert"
          .alert-icon
          .alert-content= message
          button.btn-close type="button" data-bs-dismiss="alert" aria-label="Close"

    = helpers.simple_form_for(resource, as: resource_name, url: helpers.user_session_path, html: { class: 'form-custom', data: { turbo: false } }) do |f|
      = f.error_notification

      .form-group
        = f.input :email, autofocus: true, autocomplete: 'email', input_html: { class: 'form-control-custom' }, label_html: { class: 'form-label-custom' }, label: I18n.t('sessions.form.email_label')

      .form-group
        = f.input :password, autocomplete: 'current-password', input_html: { class: 'form-control-custom' }, label_html: { class: 'form-label-custom' }

      - if devise_mapping.rememberable?
        .form-group.form-check-custom
          = f.input :remember_me, as: :boolean, input_html: { class: 'form-check-input-custom' }, label_html: { class: 'form-check-label-custom' }

      .form-actions
        = f.button :submit, I18n.t('sessions.form.submit'), class: 'btn btn-submit-custom'

    .form-footer
      - if devise_mapping.recoverable?
        = link_to I18n.t('sessions.form.forgot_password'), helpers.new_user_password_path, class: 'form-link'
      - if devise_mapping.registerable?
        p.form-footer-text
          = I18n.t('sessions.form.no_account')
          = link_to I18n.t('sessions.form.sign_up'), helpers.new_user_registration_path, class: 'form-link'
