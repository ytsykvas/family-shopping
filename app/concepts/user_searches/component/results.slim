- if has_query?
  - if has_results?
    .search-results.mt-3
      .row.g-4
        - @users.each do |user|
          .col-6.col-md-4.col-lg-3.col-xl-2
            = render UserSearches::Component::ResultCard.new(user: user, friends_ids: @friends_ids, incoming_requests: @incoming_requests, outgoing_requests: @outgoing_requests)
  - else
    .no-results.mt-3
      i.bi.bi-search.no-results-icon
      .no-results-text = I18n.t('user_searches.no_results')
